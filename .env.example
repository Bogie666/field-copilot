# AI provider: template | openai | openrouter
AI_PROVIDER=template

# Authentication is enabled unless explicitly set to false. Temporary public mode:
# FIELD_COPILOT_AUTH_ENABLED=false
FIELD_COPILOT_AUTH_ENABLED=true
FIELD_COPILOT_USER=
FIELD_COPILOT_PASS=

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Paid image analysis is opt-in. Device OCR remains available when false.
NAMEPLATE_VISION_ENABLED=false
